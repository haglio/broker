__pycache__/
*.pyc
*.egg-info/
.venv/
# Caches pytest drops in whatever directory it runs from.
.hypothesis/
.tmp-pytest-local/

# Private overlays — real values live here and never get published; each has a
# committed *.example.* template documenting its shape.
/osr2_broker_config.json
/sanitize/blocklist.local.txt

# Windows shortcuts are machine-specific and embed the real install path.
*.lnk

# pCloud conflict copies (this dir syncs via pCloud). Never our files;
# an untracked one dirties main and blocks every agent's merge.
*\[conflicted*
